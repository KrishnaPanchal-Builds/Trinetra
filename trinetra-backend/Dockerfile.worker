# TRINETRA — Celery Worker image (same codebase as gateway, different CMD)
FROM python:3.10-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl git ffmpeg libgl1 libglib2.0-0 libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN mkdir -p /tmp/trinetra /app/reports /app/fusion/weights

# CMD is overridden in docker-compose.yml with the celery invocation
CMD ["celery", "-A", "celery_worker.app.celery_app", "worker", \
     "--loglevel=info", "--concurrency=4", "--queues=enterprise,premium,basic"]
