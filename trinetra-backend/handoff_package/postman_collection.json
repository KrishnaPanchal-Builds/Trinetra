{
  "info": {
    "name": "TRINETRA API",
    "description": "Enterprise-grade B2B deepfake triage API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "System Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/system-health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "system-health"
          ]
        }
      }
    },
    {
      "name": "Generate API Key",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{api_key}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"key_type\": \"test\",\n  \"label\": \"My Test Key\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/keys",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "keys"
          ]
        }
      }
    },
    {
      "name": "Register Webhook",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{api_key}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"https://example.com/webhook\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/webhook-url",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "webhook-url"
          ]
        }
      }
    },
    {
      "name": "Submit Scan",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{api_key}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            },
            {
              "key": "uploader_declaration",
              "value": "Original footage",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/scan-media",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "scan-media"
          ]
        }
      }
    },
    {
      "name": "Poll Task Status",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{api_key}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/task/{{task_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "task",
            "{{task_id}}"
          ]
        }
      }
    },
    {
      "name": "Get Scan History",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{api_key}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/history?limit=50&offset=0",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "history"
          ],
          "query": [
            {
              "key": "limit",
              "value": "50"
            },
            {
              "key": "offset",
              "value": "0"
            }
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "api_key",
      "value": "YOUR_API_KEY_HERE"
    },
    {
      "key": "task_id",
      "value": "trk_..."
    }
  ]
}
